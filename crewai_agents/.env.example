# CrewAI Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Configuration (recommended)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration (alternative/fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CrewAI Configuration
CREWAI_LOG_LEVEL=INFO
CREWAI_MAX_ITERATIONS=25
CREWAI_MAX_EXECUTION_TIME=300

# Project Configuration
PROJECT_ROOT=/home/cbwinslow/OpenLegislation-local-dev
PROJECT_NAME=OpenLegislation

# Database Configuration (if needed for analysis)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openlegislation
DB_USER=openleg
DB_PASSWORD=your_db_password

# Elasticsearch Configuration (if needed for analysis)
ES_HOST=localhost
ES_PORT=9200

# GitHub Configuration (for repository analysis)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=cbwinslow/OpenLegislation-local-dev