# Database Configuration
# Configure these to connect to your PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openleg
DB_USER=postgres
DB_PASSWORD=

# API Keys for Data Sources
# Get Congress API key from: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# Get OpenStates API key from: https://openstates.org/accounts/profile/
OPENSTATES_API_KEY=

# Optional: GovInfo API
GOVINFO_API_KEY=
